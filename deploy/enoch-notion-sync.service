[Unit]
Description=OBSOLETE - Enoch legacy Notion sync disabled
After=enoch-control-plane.service network-online.target
Wants=enoch-control-plane.service network-online.target

[Service]
Type=oneshot
Environment=ENOCH_INSTALL_DIR=/opt/enoch-control-plane
Environment=ENOCH_CONFIG=/etc/enoch-control-plane/config.json
WorkingDirectory=/opt/enoch-control-plane
ExecStart=/opt/enoch-control-plane/deploy/enoch_notion_sync.sh
