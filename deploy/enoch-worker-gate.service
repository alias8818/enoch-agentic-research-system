[Unit]
Description=Enoch Agentic Research Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/enoch-control-plane
Environment=ENOCH_CONFIG=/etc/enoch-control-plane/config.json
EnvironmentFile=-/etc/enoch-control-plane/sentry.env
ExecStart=/opt/enoch-control-plane/.venv/bin/python -m uvicorn enoch_control_plane.app:app --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
FinalKillSignal=SIGKILL
User=enoch
Group=enoch
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/enoch-control-plane /var/log/enoch-control-plane /tmp
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Do not deny all non-loopback egress here: the control plane and Codex runner
# must reach worker wake-gates, scaffold repositories, providers,
# Supabase/Postgres, and callback endpoints.
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
