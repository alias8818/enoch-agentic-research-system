[Unit]
Description=Enoch Agentic Research Control Plane
After=network-online.target
Wants=network-online.target
OnFailure=enoch-worker-gate-failure-notify@%n.service

[Service]
Type=simple
WorkingDirectory=/opt/enoch-control-plane
Environment=ENOCH_CONFIG=/etc/enoch-control-plane/config.json
EnvironmentFile=-/etc/enoch-control-plane/sentry.env
ExecStart=/opt/enoch-control-plane/.venv/bin/python -m uvicorn enoch_control_plane.app:app --host 127.0.0.1 --port 8787
Restart=no
TimeoutStopSec=30
KillMode=mixed
FinalKillSignal=SIGKILL
User=enoch
Group=enoch
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/enoch-control-plane /var/log/enoch-control-plane /tmp
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Keep the wake-gate and any child dispatch process on loopback-only egress by
# default. High-agency Codex runs inherit this unit's cgroup; deployments that
# need provider or repository access should move the runner into a separate
# sandboxed unit/network policy instead of broadening the control-plane service.
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
