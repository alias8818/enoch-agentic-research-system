[Unit]
Description=Draft next eligible Enoch paper without dispatching work
After=enoch-control-plane.service
Wants=enoch-control-plane.service

[Service]
Type=oneshot
Environment=ENOCH_CONFIG=/etc/enoch-control-plane/config.json
Environment=ENOCH_ENABLE_PAPER_DRAFT_NEXT=0
WorkingDirectory=/opt/enoch-control-plane
ExecStart=/opt/enoch-control-plane/deploy/enoch_paper_draft_next.sh
