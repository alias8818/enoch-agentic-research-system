[Unit]
Description=Enoch capped public corpus import autopilot tick
After=enoch-control-plane.service
Wants=enoch-control-plane.service

[Service]
Type=oneshot
WorkingDirectory=/opt/enoch-control-plane
Environment=ENOCH_CONFIG=/etc/enoch-control-plane/config.json
Environment=ENOCH_RELEASE_ROOT=/opt/enoch-release
Environment=ENOCH_ENABLE_CORPUS_IMPORT_AUTOPILOT=0
Environment=ENOCH_CORPUS_IMPORT_LIMIT=1
Environment=ENOCH_CORPUS_IMPORT_PREFLIGHT_ONLY=1
Environment=ENOCH_CORPUS_IMPORT_AUTOCOMMIT=0
Environment=ENOCH_CORPUS_IMPORT_PUSH=0
Environment=ENOCH_CORPUS_IMPORT_UPDATE_GITHUB_METADATA=0
Environment=ENOCH_CORPUS_IMPORT_SKIP_GITHUB_METADATA=1
ExecStart=/opt/enoch-control-plane/.venv/bin/python /opt/enoch-control-plane/deploy/enoch_corpus_import_autopilot.py
