[Unit]
Description=Enoch queue hang/stoppage Pushover alert check
After=enoch-control-plane.service
Wants=enoch-control-plane.service

[Service]
Type=oneshot
WorkingDirectory=/opt/enoch-control-plane
Environment=ENOCH_CONFIG=/etc/enoch-control-plane/config.json
ExecStart=/opt/enoch-control-plane/.venv/bin/python /opt/enoch-control-plane/deploy/enoch_queue_alert_check.py
