[Unit]
Description=Enoch queue hang/stoppage Pushover alert check
After=enoch-control-plane.service
Wants=enoch-control-plane.service

[Service]
Type=oneshot
User=enoch
Group=enoch
WorkingDirectory=/opt/enoch-control-plane
Environment=ENOCH_CONFIG=/etc/enoch-control-plane/config.json
ExecStart=/opt/enoch-control-plane/.venv/bin/python /opt/enoch-control-plane/deploy/enoch_queue_alert_check.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/enoch-control-plane /var/log/enoch-control-plane /tmp
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
